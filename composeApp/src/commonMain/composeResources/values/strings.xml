    <!-- ContributionScreen -->
    <string name="contrib_title">Bijdragen aan de database</string>
    
    <string name="contrib_picker_title">Welk gebaar wil je opnemen?</string>
    <string name="contrib_picker_desc">Elke bijdrage wordt eerst door een beoordelaar bekeken voordat andere gebruikers hem als referentie krijgen — jouw opname gaat dus nooit direct live.</string>
    <string name="contrib_picker_alphabet">🔤 Alfabet</string>
    <string name="contrib_picker_numbers">🔢 Cijfers</string>
    <string name="contrib_picker_other">✨ Andere Gebaren</string>
    <string name="contrib_back">Terug</string>
    
    <string name="contrib_consent_title">Toestemming</string>
    <string name="contrib_consent_p1">We nemen een korte reeks beelden van je hand op, samen met de bewegingsdata (landmarks) die de app al gebruikt om gebaren te herkennen.</string>
    <string name="contrib_consent_p2">De beelden zijn alleen zichtbaar voor beoordelaars, uitsluitend om te controleren of het gebaar correct is uitgevoerd. Ze worden niet gedeeld met andere gebruikers en niet gebruikt voor iets anders dan deze beoordeling.</string>
    <string name="contrib_consent_p3">Na goedkeuring wordt alleen de bewegingsdata (geen beeld) toegevoegd aan de gedeelde referentiedatabase. Je kunt op elk moment vragen om je bijdrage te laten verwijderen.</string>
    <string name="contrib_consent_check">Ik geef toestemming voor het opnemen en beoordelen van deze bijdrage.</string>
    <string name="contrib_cancel">Annuleren</string>
    <string name="contrib_start">Start opname</string>
    
    <string name="contrib_countdown_title">Zet je hand klaar</string>
    <string name="contrib_countdown_desc">Zet je hand nu al in de vorm van het gebaar en houd hem stil in beeld. De opname begint vanzelf zodra het aftellen klaar is — dan even stil blijven houden tot de balk vol is.</string>
    <string name="contrib_countdown_go">Ga!</string>
    
    <string name="contrib_recording_title">Opnemen…</string>
    <string name="contrib_recording_desc">Nu opnemen — houd de handvorm stil tot de balk hieronder vol is. Niet meer bewegen of van vorm veranderen tijdens het opnemen.</string>
    
    <string name="contrib_uploading">Bijdrage versturen…</string>
    
    <string name="contrib_success_title">Bedankt voor je bijdrage!</string>
    <string name="contrib_success_desc">Een beoordelaar bekijkt je opname binnenkort. Zodra hij is goedgekeurd, helpt hij andere gebruikers dit gebaar nauwkeuriger te herkennen.</string>
    <string name="contrib_success_again">Nog een gebaar opnemen</string>
    <string name="contrib_success_back">Terug naar oefenen</string>
    
