    <!-- ContributionScreen -->
    <string name="contrib_title">Contribute to the database</string>
    
    <string name="contrib_picker_title">Which gesture do you want to record?</string>
    <string name="contrib_picker_desc">Every contribution is first reviewed by an admin before other users get it as a reference — so your recording never goes live directly.</string>
    <string name="contrib_picker_alphabet">🔤 Alphabet</string>
    <string name="contrib_picker_numbers">🔢 Numbers</string>
    <string name="contrib_picker_other">✨ Other Gestures</string>
    <string name="contrib_back">Back</string>
    
    <string name="contrib_consent_title">Consent</string>
    <string name="contrib_consent_p1">We record a short sequence of images of your hand, along with the movement data (landmarks) that the app already uses to recognize gestures.</string>
    <string name="contrib_consent_p2">The images are only visible to reviewers, solely to verify that the gesture was executed correctly. They are not shared with other users and are not used for anything other than this review.</string>
    <string name="contrib_consent_p3">After approval, only the movement data (no image) is added to the shared reference database. You can ask to have your contribution removed at any time.</string>
    <string name="contrib_consent_check">I give my consent to record and review this contribution.</string>
    <string name="contrib_cancel">Cancel</string>
    <string name="contrib_start">Start recording</string>
    
    <string name="contrib_countdown_title">Get your hand ready</string>
    <string name="contrib_countdown_desc">Put your hand in the shape of the gesture now and hold it still in the frame. The recording will start automatically once the countdown is done — then just hold it still until the bar is full.</string>
    <string name="contrib_countdown_go">Go!</string>
    
    <string name="contrib_recording_title">Recording…</string>
    <string name="contrib_recording_desc">Recording now — hold the hand shape still until the bar below is full. Do not move or change shape while recording.</string>
    
    <string name="contrib_review_title">Is your recording right?</string>
    <string name="contrib_review_desc">This is a frame from your recording. Is your hand fully and sharply in view, with the right handshape? Then send it to the reviewer. If not, just record it again.</string>
    <string name="contrib_review_retake">Record again</string>
    <string name="contrib_review_send">Send</string>
    <string name="contrib_uploading">Sending contribution…</string>
    
    <string name="contrib_success_title">Thanks for your contribution!</string>
    <string name="contrib_success_desc">A reviewer will check your recording shortly. Once approved, it will help other users recognize this gesture more accurately.</string>
    <string name="contrib_success_again">Record another gesture</string>
    <string name="contrib_success_back">Back to practice</string>
    
